{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "worker/**/*.ts", "vite.config.ts", "vitest.config.ts", "tests/vue/**/*.ts", "lib/**/*.d.mts", "server/**/*.d.mts"],
  "exclude": ["node_modules", "dist", "work", "outputs"]
}
